<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.crawlsnek.ptt-price-commentary</string>
    <key>ProgramArguments</key>
    <array><string>/usr/bin/python3</string><string>__CODE_DIR__/local/price_commentary_monthly.py</string></array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/ptt-price-commentary.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ptt-price-commentary.log</string>
</dict>
</plist>
